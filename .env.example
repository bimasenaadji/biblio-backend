# Application
APP_NAME=Biblio
APP_ENV=development
APP_PORT=3000

# PostgreSQL Standalone (Port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_USER=biblio_user
DB_PASSWORD=biblio_password
DB_NAME=biblio_db
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Jakarta

# MinIO S3 (Fase 4)
MINIO_ENABLED=true
MINIO_API_PORT=9000
MINIO_ROOT_USER=biblio_minio_admin
MINIO_ROOT_PASSWORD=biblio_minio_password
MINIO_BUCKET=biblio-covers

# OpenTelemetry Jaeger (Fase 5)
OTEL_ENABLED=true
JAEGER_OTLP_GRPC_PORT=4317